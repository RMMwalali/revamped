PORT=3000
SESSION_TTL_HOURS=72

# Admin auth credentials for /insider login.
# ADMIN_PASSWORD must be a pre-hashed bcrypt string (cost 12). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=$2b$12$...your-hashed-password...

# HMAC secret for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your-random-32-byte-hex-string

# Uploads: Vercel Blob token (dashboard Storage tab). Omit locally (disk fallback).
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx
