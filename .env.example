PORT=3000
SESSION_TTL_HOURS=72

# Admin auth credentials for /insider login.
# ADMIN_PASSWORD must be a pre-hashed bcrypt string (cost 12). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=$2b$12$...your-hashed-password...

# HMAC secret for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your-random-32-byte-hex-string

# Uploads: Vercel Blob token (dashboard Storage tab). Omit locally (disk fallback).
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Storage for admin saves + uploads: Cloudflare R2 (S3 API token with
# "Object Read & Write" on the bucket). Same values on Vercel for Production
# and Preview. R2_PUBLIC_URL = the bucket's public r2.dev URL or custom domain.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# EU-jurisdiction bucket only: R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# Website enquiries are emailed to the company inbox (free options; set ONE):
#  A) Gmail / Google Workspace: SMTP_USER = sending address, SMTP_PASS = 16-character
#     App Password (Google Account > Security > 2-Step Verification > App passwords).
#     SMTP_HOST defaults to smtp.gmail.com (port 465). Free: 500/day (2,000 Workspace).
#  B) Brevo SMTP (free 300/day) or any mail host: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
#  C) Resend (free 3,000/month, verified domain): RESEND_API_KEY, RESEND_FROM
# LEAD_EMAIL_TO=info@stillcraftevents.co.ke   (default; comma-separate for several)
# SMTP_USER=
# SMTP_PASS=
