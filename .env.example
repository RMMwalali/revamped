# Local (least-privilege app role on the machine's PostgreSQL service):
DATABASE_URL=postgresql://stillcraft_app:[APP_PASSWORD]@127.0.0.1:5432/stillcraft
# Production (Supabase): paste the pooled connection string from the dashboard.
# The server enables SSL automatically for non-local hosts.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.XXXX.supabase.co:5432/postgres
PORT=3000
SESSION_TTL_HOURS=72
