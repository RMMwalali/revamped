{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects/page/:n", "destination": "/projects", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/_next/image", "destination": "/api/img" },
    {
      "source": "^/(?!api(?:/|$)|_next/(?:image|static)|assets/|upload/|icons/|[^/]*\\.[A-Za-z0-9]+$)(.*)$",
      "destination": "/api/page?path=/$1"
    }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "dist/**" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
