      },
      "continue": true
    },
    {
      "src": "^/api/upload/?$",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)/?$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/_next/static/(.*)/?$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/projects/page/([^/]+)/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/project/mothers-day-brunch-at-southfield-mall/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/project/adidas-display-wall/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
