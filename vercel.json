{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects/page/:n", "destination": "/projects", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/_next/image", "destination": "/api/img" },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text\\/html.*" }],
      "destination": "/api/page?path=/"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text\\/html.*" }],
      "destination": "/api/page?path=/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
