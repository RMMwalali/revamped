    },
    {
      "src": "^/service/events(?:/|/index\\.html|\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "/service/brand-activations"
      }
    },
    {
      "src": "^/_next/image$",
      "dest": "/api/img"
    },
    {
      "src": "^/project/world-cup-watch-party-at-galleria-mall(?:/|/index\\.html|\\.html)?$",
