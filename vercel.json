    },
    {
      "src": "^/projects/mall-activations/?$",
      "dest": "/api/page?path=/projects"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/page?path=/sitemap.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/api/page?path=/robots.txt"
    },
    {
      "src": "^/insider/?$",
      "dest": "/insider/index.html"
    },
    {
      "src": "^/404(?:\\.html)?$",
      "status": 404,
      "dest": "/api/page?path=/404"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api/).*$",
      "status": 404,
      "dest": "/api/page?path=/404"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/**/*.html"
    },
    "api/cms.js": {
      "includeFiles": "dist/**/*.html"
    },
    "api/img.js": {
      "includeFiles": "dist/assets/**"
    },
    "api/login.js": {
      "includeFiles": "scripts/auth.mjs"
    },
    "api/logout.js": {
      "includeFiles": "scripts/auth.mjs"
    },
    "api/me.js": {
      "includeFiles": "scripts/auth.mjs"
    },
    "api/brand.js": {
      "includeFiles": "scripts/*.mjs"
    },
    "api/content.js": {
      "includeFiles": "scripts/*.mjs"
    },
    "api/upload.js": {
      "includeFiles": "scripts/*.mjs"
    },
    "api/lead.js": {
      "includeFiles": "scripts/*.mjs"
    },
    "api/leads.js": {
      "includeFiles": "scripts/*.mjs"
