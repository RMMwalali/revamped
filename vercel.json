      }
    },
    {
      "src": "^/project/ypo-global-event/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/service/sports/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/insights(?:/(.*))?/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/insight(?:/(.*))?/?$",
      "status": 302,
      "headers": {
        "Location": "/projects"
      }
    },
    {
      "src": "^/service/exhibits(?:/|/index\\.html|\\.html)?$",
      "status": 301,
      "headers": {
        "Location": "/service/mall-calendar-programming"
      }
    },
    {
      "src": "^/service/congresses(?:/|/index\\.html|\\.html)?$",
